{
  // Joshua's Painting Service — public site + job manager on one Cloudflare Worker.
  "name": "atelier-blanc",
  // Josué's own Cloudflare account (Joshuapaintingjm@gmail.com's Account)
  "account_id": "0100e65029b205547b335da30d236440",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-12",
  // joshuapaintingjm.com (bought in this Cloudflare account) serves the site; www forwards here via www-redirect/
  // add back once the domain has moved into this account (about Dec 4):
  // "routes": [{ "pattern": "joshuapaintingjm.com", "custom_domain": true }],
  // keep the old atelier-blanc.raymondsantopietro.workers.dev address working (pages say the new domain is the real one)
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // unknown addresses get public/404.html (built by tools/build_pages.py) with a 404 status
    "not_found_handling": "404-page",
    // only /api/* needs code; static files are served straight from the edge
    "run_worker_first": ["/api/*", "/static", "/static/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atelier-blanc",
      // replace with the id printed by: npx wrangler d1 create atelier-blanc
      "database_id": "46ad63a6-a7e9-40e6-8e4a-69b83786d787"
    }
  ],
  // spam guard for the quote form: 5 requests a minute per visitor address
  "ratelimits": [
    { "name": "QUOTE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  // daily: delete quote requests older than a week that never became a job
  "triggers": { "crons": ["0 10 * * *"] }
}

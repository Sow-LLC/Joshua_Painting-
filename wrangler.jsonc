{
  // Joshua's Painting Service — public site + job manager on one Cloudflare Worker.
  "name": "atelier-blanc",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // unknown addresses get public/404.html (built by tools/build_pages.py) with a 404 status
    "not_found_handling": "404-page",
    // only /api/* needs code; static files are served straight from the edge
    "run_worker_first": ["/api/*", "/static", "/static/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atelier-blanc",
      // replace with the id printed by: npx wrangler d1 create atelier-blanc
      "database_id": "616ed0c3-a617-4ef7-bd83-c582837c7708"
    }
  ]
}
